{
  "buildCommand": "npm --prefix routemate-person-b run build",
  "outputDirectory": "routemate-person-b/dist-web",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/api", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  }
}
